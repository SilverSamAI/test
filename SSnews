                            <span id="analyze-tags-loader" class="loader hidden"></span>
                            <span id="analyze-tags-text">Analyze Article Tags ✨</span>
                        </button>
                        <button id="generate-briefing-btn" class="w-full sm:w-auto flex-shrink-0 text-sm font-semibold px-4 py-2 rounded-full bg-gray-700 text-gray-200 shadow-sm hover:bg-gray-600 transition-all">Generate AI Briefing ✨</button>
                    </div>
                </section>

                <section id="smart-tags-section" class="mb-12">
                    <h2 class="text-3xl font-bold text-white mb-6 border-b-2 border-[#00F0B5] pb-2">Explore Key Entities</h2>
                    <div id="tags-container" class="flex flex-wrap gap-2">
                        <p id="tags-placeholder" class="text-gray-400">Run "Analyze Article Tags" to populate this section.</p>
