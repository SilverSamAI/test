# Center API credentials - get these from your Center admin or developer.getcenter.com
CENTER_API_KEY=your_center_api_key_here
CENTER_API_VERSION=2024-01-01
CENTER_BASE_URL=https://api.getcenter.com

# Set to "sandbox" for testing, "production" for real expenses
CENTER_ENVIRONMENT=sandbox

# Anthropic API key for AI-powered expense categorization
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Autonomous run settings
# How often to poll for new expenses (in minutes)
POLL_INTERVAL_MINUTES=15

# Auto-submit expenses for approval without review (true/false)
AUTO_SUBMIT=false

# Default GL codes to map categories to (comma-separated "category:code" pairs)
# Example: travel:6010,meals:6020,software:6030,office:6040,other:6099
GL_CODE_MAP=travel:6010,meals:6020,software:6030,office:6040,other:6099
