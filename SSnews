                <div class="flex flex-col sm:flex-row justify-between items-center mb-10 gap-4">
                    <nav id="filter-nav" class="flex flex-wrap justify-center gap-2 sm:gap-4">
                        <button data-filter="all" class="nav-btn active">All News</button>
                        <button data-filter="reading_list" class="nav-btn">My Reading List</button>
                        <button data-filter="adoption" class="nav-btn">Creative Adoption</button>
                        <button data-filter="environment" class="nav-btn">Environmental</button>
